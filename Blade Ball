clickerFrame.BorderSizePixel = 0
clickerFrame.LayoutOrder = 3
clickerFrame.Parent = combatScroll
Instance.new("UICorner", clickerFrame).CornerRadius = UDim.new(0, 6)

local clickerLabel = Instance.new("TextLabel")
clickerLabel.Size = UDim2.new(0.55, 0, 1, 0)
clickerLabel.Position = UDim2.new(0, 12, 0, 0)
clickerLabel.BackgroundTransparency = 1
clickerLabel.Text = "Auto Clicker (Hold)"
clickerLabel.TextColor3 = Color3.fromRGB(200, 200, 210)
clickerLabel.TextSize = 13
clickerLabel.Font = Enum.Font.Gotham
clickerLabel.TextXAlignment = Enum.TextXAlignment.Left
clickerLabel.Parent = clickerFrame

local clickerKeyBtn = Instance.new("TextButton")
clickerKeyBtn.Size = UDim2.new(0, 70, 0, 24)
clickerKeyBtn.Position = UDim2.new(1, -82, 0.5, -12)
clickerKeyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
clickerKeyBtn.Text = autoClickerKey.Name
clickerKeyBtn.TextColor3 = Color3.fromRGB(220, 220, 240)
clickerKeyBtn.TextSize = 12
clickerKeyBtn.Font = Enum.Font.GothamBold
clickerKeyBtn.Parent = clickerFrame
Instance.new("UICorner", clickerKeyBtn).CornerRadius = UDim.new(0, 5)

clickerKeyBtn.MouseButton1Click:Connect(function()
	if isListeningForClickerKey then return end
	isListeningForClickerKey = true
	clickerKeyBtn.Text = "..."
	clickerKeyBtn.BackgroundColor3 = Color3.fromRGB(90, 70, 40)
end)

createSection(combatScroll, "Spin", 4)
local forceSpin = createToggle(combatScroll, "Spin", 5, false, function(s)
	spinEnabled = s
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid.AutoRotate = not s end
end)
createSlider(combatScroll, "Spin Speed", 6, 1, 30, 12, function(v) spinSpeed = v end)

-- Visuals Tab
createSection(visualsScroll, "Player ESP", 1)
local forcePlayerESP = createToggle(visualsScroll, "Player ESP", 2, false, function(s)
	playerEspEnabled = s
	refreshAllPlayerESP()
end)
local forceHighlight = createToggle(visualsScroll, "Highlight", 3, false, function(s)
	highlightEnabled = s
	updatePlayerESP()
end)
local forceAbility = createToggle(visualsScroll, "Show Ability", 4, false, function(s)
	showAbility = s
	updatePlayerESP()
end)

createSection(visualsScroll, "Ball ESP", 6)
local forceBallESP = createToggle(visualsScroll, "Ball ESP", 7, false, function(s)
	ballEspEnabled = s
	if not s then clearBallESP() end
end)
local forceBallTracer = createToggle(visualsScroll, "Ball Tracer", 8, false, function(s)
	ballTracerEnabled = s
	updateBallESP()
end)
local forceBallVelocity = createToggle(visualsScroll, "Ball Velocity", 9, false, function(s)
	ballVelocityEnabled = s
	updateBallESP()
end)

-- Settings Tab
createSection(settingsScroll, "Camera", 1)
local forceFovUnlock = createToggle(settingsScroll, "FOV Unlocker", 2, false, function(s)
	fovUnlockEnabled = s
	player.CameraMaxZoomDistance = s and 9999 or originalMaxZoom
	player.CameraMinZoomDistance = s and 0.5 or originalMinZoom
end)

keyBtn.MouseButton1Click:Connect(function()
	if isListeningForKey then return end
	isListeningForKey = true
	keyBtn.Text = "Press a key..."
	keyBtn.BackgroundColor3 = Color3.fromRGB(90, 70, 40)
end)

Players.PlayerAdded:Connect(setupPlayerESP)
Players.PlayerRemoving:Connect(removeESP)
for _, plr in ipairs(Players:GetPlayers()) do setupPlayerESP(plr) end

player.CharacterAdded:Connect(function(char)
	if playerEspEnabled then
		task.wait(0.8)
		refreshAllPlayerESP()
	end
	task.wait(0.5)
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if humanoid and spinEnabled then humanoid.AutoRotate = false end
end)

local lastEspUpdate = 0
heartbeatConn = RunService.Heartbeat:Connect(function()
	local now = tick()
	if playerEspEnabled and now - lastEspUpdate > 0.15 then
		updatePlayerESP()
		lastEspUpdate = now
	end
	if ballEspEnabled then updateBallESP() end
	if autoParryEnabled then checkAutoParry() end
end)

renderConn = RunService.RenderStepped:Connect(function(dt)
	if spinEnabled then
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(spinSpeed * dt * 60), 0)
		end
	end
	if fovUnlockEnabled and player.CameraMaxZoomDistance < 9000 then
		player.CameraMaxZoomDistance = 9999
	end
end)

task.spawn(function()
	while screenGui.Parent do
		if autoClickerHolding then
			doClick()
			task.wait(0.055 + math.random() * 0.025)
		else
			task.wait(0.08)
		end
	end
end)

inputBeganConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if isListeningForKey and input.UserInputType == Enum.UserInputType.Keyboard then
		toggleKey = input.KeyCode
		keyBtn.Text = toggleKey.Name
		keyBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
		isListeningForKey = false
		return
	end
	if isListeningForClickerKey and input.UserInputType == Enum.UserInputType.Keyboard then
		autoClickerKey = input.KeyCode
		clickerKeyBtn.Text = autoClickerKey.Name
		clickerKeyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
		isListeningForClickerKey = false
		return
	end
	if gameProcessed then return end
	if keybindEnabled and input.KeyCode == toggleKey and not isListeningForKey then
		mainFrame.Visible = not mainFrame.Visible
	end
	if input.KeyCode == autoClickerKey and not isListeningForClickerKey then
		autoClickerHolding = true
	end
end)

inputEndedConn = UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == autoClickerKey then
		autoClickerHolding = false
	end
end)

pages["Combat"].Visible = true
tabs["Combat"].BackgroundColor3 = Color3.fromRGB(70, 100, 180)
tabs["Combat"].TextColor3 = Color3.fromRGB(255, 255, 255)

closeBtn.MouseButton1Click:Connect(function()
	confirmFrame.Visible = true
	mainFrame.Visible = false
	autoClickerHolding = false
end)

noBtn.MouseButton1Click:Connect(function()
	confirmFrame.Visible = false
	mainFrame.Visible = true
end)

yesBtn.MouseButton1Click:Connect(function()
	forcePlayerESP(false)
	forceHighlight(false)
	forceAbility(false)
	forceBallESP(false)
	forceBallTracer(false)
	forceBallVelocity(false)
	forceAutoParry(false)
	forceSpin(false)
	forceFovUnlock(false)
	keybindEnabled = false
	autoParryEnabled = false
	autoClickerHolding = false
	spinEnabled = false
	fovUnlockEnabled = false
	player.CameraMaxZoomDistance = originalMaxZoom
	player.CameraMinZoomDistance = originalMinZoom
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid.AutoRotate = true end
	if inputBeganConn then inputBeganConn:Disconnect() end
	if inputEndedConn then inputEndedConn:Disconnect() end
	if heartbeatConn then heartbeatConn:Disconnect() end
	if renderConn then renderConn:Disconnect() end
	clearBallESP()
	for plr in pairs(espObjects) do removeESP(plr) end
	screenGui:Destroy()
end)
