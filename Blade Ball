local function updatePlayerESP()
	for plr, data in pairs(espObjects) do
		if not plr.Parent then
			removeESP(plr)
			continue
		end
		local alive = isPlayerAlive(plr)

		if data.Highlight then
			data.Highlight.Enabled = playerEspEnabled
			data.Highlight.FillTransparency = highlightEnabled and 0.55 or 1
			local col = alive and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 50, 50)
			data.Highlight.FillColor = col
			data.Highlight.OutlineColor = col
		end

		if data.Billboard then
			local abilityLabel = data.Billboard:FindFirstChild("AbilityLabel")
			local statusLabel = data.Billboard:FindFirstChild("StatusLabel")
			if abilityLabel then
				abilityLabel.Visible = showAbility
				if showAbility then
					abilityLabel.Text = "Ability: " .. tostring(plr:GetAttribute("EquippedAbility") or "None")
				end
			end
			if statusLabel then
				statusLabel.Text = alive and "ALIVE" or "DEAD"
				statusLabel.TextColor3 = alive and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 70, 70)
			end
		end
	end
end

local function refreshAllPlayerESP()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			if playerEspEnabled then createESP(plr) else removeESP(plr) end
		end
	end
end

local function setupPlayerESP(plr)
	if plr == player then return end
	plr.CharacterAdded:Connect(function()
		if playerEspEnabled then
			task.wait(0.8)
			createESP(plr)
		end
	end)
	if plr.Character and playerEspEnabled then
		task.defer(function()
			task.wait(0.5)
			createESP(plr)
		end)
	end
end

local cachedBall, lastBallSearch = nil, 0
local function getBall()
	local folder = workspace:FindFirstChild("Balls")
	if not folder then
		cachedBall = nil
		return nil
	end
	if cachedBall and cachedBall.Parent == folder and cachedBall:GetAttribute("realBall") then
		return cachedBall
	end
	local now = tick()
	if now - lastBallSearch < 0.06 then
		return cachedBall
	end
	lastBallSearch = now
	for _, v in ipairs(folder:GetChildren()) do
		if v:GetAttribute("realBall") then
			cachedBall = v
			return v
		end
	end
	for _, v in ipairs(folder:GetChildren()) do
		if v:IsA("BasePart") then
			cachedBall = v
			return v
		elseif v:IsA("Model") then
			local part = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
			if part then
				cachedBall = part
				return part
			end
		end
	end
	cachedBall = nil
	return nil
end

local function clearBallESP()
	if ballBeam then ballBeam:Destroy() ballBeam = nil end
	if ballAtt0 then ballAtt0:Destroy() ballAtt0 = nil end
	if ballAtt1 then ballAtt1:Destroy() ballAtt1 = nil end
	if ballVelocityBillboard then ballVelocityBillboard:Destroy() ballVelocityBillboard = nil end
end

local function updateBallESP()
	if not ballEspEnabled then
		clearBallESP()
		return
	end
	local ball = getBall()
	local localHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not ball or not localHRP then
		clearBallESP()
		return
	end
	local isTargetingMe = ball:GetAttribute("target") == player.Name

	if ballTracerEnabled then
		if not ballBeam then
			ballAtt0 = Instance.new("Attachment")
			ballAtt0.Parent = localHRP
			ballAtt1 = Instance.new("Attachment")
			ballAtt1.Parent = ball
			ballBeam = Instance.new("Beam")
			ballBeam.Attachment0 = ballAtt0
			ballBeam.Attachment1 = ballAtt1
			ballBeam.FaceCamera = true
			ballBeam.Width0 = 0.55
			ballBeam.Width1 = 0.55
			ballBeam.Transparency = NumberSequence.new(0.05)
			ballBeam.LightEmission = 1
			ballBeam.LightInfluence = 0
			ballBeam.Parent = localHRP
		end
		if ballAtt1.Parent ~= ball then ballAtt1.Parent = ball end
		ballBeam.Color = isTargetingMe and ColorSequence.new(Color3.fromRGB(255, 40, 40)) or ColorSequence.new(Color3.fromRGB(255, 140, 0))
		ballBeam.Enabled = true
	elseif ballBeam then
		ballBeam.Enabled = false
	end

	if ballVelocityEnabled then
		if not ballVelocityBillboard then
			ballVelocityBillboard = Instance.new("BillboardGui")
			ballVelocityBillboard.Size = UDim2.new(0, 120, 0, 28)
			ballVelocityBillboard.StudsOffset = Vector3.new(0, 3.2, 0)
			ballVelocityBillboard.AlwaysOnTop = true
			ballVelocityBillboard.Parent = ball
			local velLabel = Instance.new("TextLabel")
			velLabel.Name = "VelocityLabel"
			velLabel.Size = UDim2.new(1, 0, 1, 0)
			velLabel.BackgroundTransparency = 1
			velLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
			velLabel.TextStrokeTransparency = 0.3
			velLabel.TextSize = 14
			velLabel.Font = Enum.Font.GothamBold
			velLabel.Parent = ballVelocityBillboard
		end
		if ballVelocityBillboard.Parent ~= ball then ballVelocityBillboard.Parent = ball end
		local speed = 0
		if ball:IsA("BasePart") then
			local zoomies = ball:FindFirstChild("zoomies")
			speed = zoomies and zoomies.VectorVelocity.Magnitude or ball.AssemblyLinearVelocity.Magnitude
		end
		local velLabel = ballVelocityBillboard:FindFirstChild("VelocityLabel")
		if velLabel then velLabel.Text = string.format("%.0f studs/s", speed) end
		ballVelocityBillboard.Enabled = true
	elseif ballVelocityBillboard then
		ballVelocityBillboard.Enabled = false
	end
end

local function checkAutoParry()
	if not autoParryEnabled or isClicking then return end

	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local ball = getBall()
	if not ball or not ball:IsA("BasePart") then return end
	if ball:GetAttribute("target") ~= player.Name then return end

	local now = tick()
	if now - lastHitTime < 0.125 then return end

	local ballPos = ball.Position
	local playerPos = hrp.Position
	local distance = (ballPos - playerPos).Magnitude

	local ballVel = ball.AssemblyLinearVelocity
	local zoomies = ball:FindFirstChild("zoomies")
	if zoomies then ballVel = zoomies.VectorVelocity end

	local ballSpeed = ballVel.Magnitude
	if ballSpeed < 4 then return end

	local relativeVel = ballVel - hrp.AssemblyLinearVelocity
	local toPlayer = playerPos - ballPos
	if toPlayer.Magnitude < 0.12 then return end

	local closingSpeed = relativeVel:Dot(toPlayer.Unit)
	if closingSpeed < 2.2 then return end

	local timeToHit = distance / closingSpeed

	local window = math.clamp(0.165 + (ballSpeed / 125), 0.13, 0.50)
	local maxDist = math.clamp(13 + ballSpeed * 0.155, 15, 78)

	if timeToHit <= window and distance <= maxDist then
		lastHitTime = now
		task.spawn(doClick)
	end
end

