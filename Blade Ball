local function createSlider(parent, text, order, min, max, default, callback)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 0, 50)
	frame.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
	frame.BorderSizePixel = 0
	frame.LayoutOrder = order
	frame.Parent = parent
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -20, 0, 20)
	label.Position = UDim2.new(0, 12, 0, 4)
	label.BackgroundTransparency = 1
	label.Text = text .. ": " .. string.format("%.0f", default)
	label.TextColor3 = Color3.fromRGB(200, 200, 210)
	label.TextSize = 13
	label.Font = Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, -24, 0, 8)
	bar.Position = UDim2.new(0, 12, 0, 30)
	bar.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
	bar.BorderSizePixel = 0
	bar.Parent = frame
	Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 4)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(70, 130, 220)
	fill.BorderSizePixel = 0
	fill.Parent = bar
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 4)

	local knob = Instance.new("TextButton")
	knob.Size = UDim2.new(0, 16, 0, 16)
	knob.Position = UDim2.new((default - min) / (max - min), -8, 0.5, -8)
	knob.BackgroundColor3 = Color3.fromRGB(240, 240, 255)
	knob.Text = ""
	knob.Parent = bar
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local dragging = false

	local function update(val)
		val = math.clamp(val, min, max)
		local alpha = (val - min) / (max - min)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, -8, 0.5, -8)
		label.Text = text .. ": " .. string.format("%.0f", val)
		callback(val)
	end

	knob.MouseButton1Down:Connect(function()
		dragging = true
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local rel = (input.Position.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1)
			update(min + rel * (max - min))
		end
	end)

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local rel = (input.Position.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1)
			update(min + rel * (max - min))
			dragging = true
		end
	end)
end

local function doClick()
	if isClicking then return end
	isClicking = true
	local pos = UserInputService:GetMouseLocation()
	VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
	task.wait(0.02)
	VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
	task.wait(0.05)
	isClicking = false
end

local function removeESP(plr)
	local data = espObjects[plr]
	if not data then return end
	if data.Highlight then data.Highlight:Destroy() end
	if data.Billboard then data.Billboard:Destroy() end
	espObjects[plr] = nil
end

local function isPlayerAlive(plr)
	local char = plr.Character
	if not char then return false end
	local aliveFolder = workspace:FindFirstChild("Alive")
	return aliveFolder and char.Parent == aliveFolder
end

