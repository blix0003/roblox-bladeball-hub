local function updateBallTargetGui()
	if not ballTargetEnabled or not ballTargetLabel then return end

	local ball = getBall()
	local targetName = "None"
	local isMe = false

	if ball then
		local rawTarget = ball:GetAttribute("target")
		if rawTarget and rawTarget ~= "" and rawTarget ~= "None" then
			local targetPlr = Players:FindFirstChild(tostring(rawTarget))
			if targetPlr then
				targetName = targetPlr.DisplayName
				isMe = (targetPlr == player)
			else
				targetName = tostring(rawTarget)
				isMe = (rawTarget == player.Name)
			end
		end
	end

	ballTargetLabel.Text = targetName

	if isMe then
		ballTargetLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
		ballTargetFrame.BackgroundColor3 = Color3.fromRGB(45, 22, 22)
	else
		ballTargetLabel.TextColor3 = Color3.fromRGB(200, 200, 210)
