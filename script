local function removeESP(plr)
	local data = espObjects[plr]
	if not data then return end
	if data.Highlight then data.Highlight:Destroy() end
	if data.Billboard then data.Billboard:Destroy() end
	if data.Beam then data.Beam:Destroy() end
	if data.Attachment0 then data.Attachment0:Destroy() end
	if data.Attachment1 then data.Attachment1:Destroy() end
	espObjects[plr] = nil
end

local function isPlayerAlive(plr)
	local char = plr.Character
	if not char then return false end
	local aliveFolder = workspace:FindFirstChild("Alive")
	return aliveFolder and char.Parent == aliveFolder
end

local function createESP(plr)
	if plr == player then return end
	removeESP(plr)
	local char = plr.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 3)
	local head = char:FindFirstChild("Head") or char:WaitForChild("Head", 3)
	if not hrp then return end

	local highlight = Instance.new("Highlight")
	highlight.Name = "BlixHighlight"
	highlight.Adornee = char
	highlight.FillTransparency = 0.7
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Enabled = playerEspEnabled
	highlight.Parent = char

	local billboard
	if head then
		billboard = Instance.new("BillboardGui")
		billboard.Name = "BlixESP"
		billboard.Adornee = head
		billboard.Size = UDim2.new(0, 260, 0, 70)
		billboard.StudsOffset = Vector3.new(0, 5.2, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent = head

		local function makeLabel(name, y, size, color)
			local l = Instance.new("TextLabel")
			l.Name = name
			l.Size = UDim2.new(1, 0, 0, size)
			l.Position = UDim2.new(0, 0, 0, y)
			l.BackgroundTransparency = 1
			l.TextColor3 = color
			l.TextStrokeTransparency = 0.1
			l.TextStrokeColor3 = Color3.new(0, 0, 0)
			l.TextSize = size == 22 and 17 or (size == 20 and 15 or 14)
			l.Font = Enum.Font.GothamBold
			l.Parent = billboard
			return l
		end
		makeLabel("NameLabel", 0, 20, Color3.fromRGB(255, 255, 255))
		makeLabel("AbilityLabel", 20, 22, Color3.fromRGB(100, 220, 255))
		makeLabel("StatusLabel", 42, 18, Color3.fromRGB(255, 255, 255))
	end

	local localHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local beam, att0, att1
	if localHRP then
		att0 = Instance.new("Attachment")
		att0.Parent = localHRP
		att1 = Instance.new("Attachment")
		att1.Parent = hrp
		beam = Instance.new("Beam")
		beam.Attachment0 = att0
		beam.Attachment1 = att1
		beam.FaceCamera = true
		beam.Width0 = 0.22
		beam.Width1 = 0.22
		beam.Color = ColorSequence.new(Color3.fromRGB(0, 255, 120))
		beam.Transparency = NumberSequence.new(0.2)
		beam.LightEmission = 0.8
		beam.LightInfluence = 0
		beam.Enabled = tracerEnabled and playerEspEnabled
		beam.Parent = localHRP
	end

	espObjects[plr] = {
		Highlight = highlight,
		Billboard = billboard,
		Beam = beam,
		Attachment0 = att0,
		Attachment1 = att1
	}
end

local function updatePlayerESP()
	local localHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	for plr, data in pairs(espObjects) do
		if not plr.Parent then
			removeESP(plr)
			continue
		end
		local char = plr.Character
		local alive = isPlayerAlive(plr)
		local hrp = char and char:FindFirstChild("HumanoidRootPart")

		if data.Highlight then
			data.Highlight.Enabled = playerEspEnabled
			data.Highlight.FillTransparency = highlightEnabled and 0.55 or 1
			local col = alive and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 50, 50)
			data.Highlight.FillColor = col
			data.Highlight.OutlineColor = col
		end

		if data.Beam then
			local show = tracerEnabled and playerEspEnabled and alive and localHRP and hrp
			data.Beam.Enabled = show
			if show then
				if data.Attachment0 and data.Attachment0.Parent ~= localHRP then data.Attachment0.Parent = localHRP end
				if data.Attachment1 and data.Attachment1.Parent ~= hrp then data.Attachment1.Parent = hrp end
			end
		end

		if data.Billboard then
			local nameLabel = data.Billboard:FindFirstChild("NameLabel")
			local abilityLabel = data.Billboard:FindFirstChild("AbilityLabel")
			local statusLabel = data.Billboard:FindFirstChild("StatusLabel")
			if nameLabel then
				nameLabel.Visible = showUsername
				if showUsername then
					nameLabel.Text = plr.DisplayName
				end
			end
			if abilityLabel then
				abilityLabel.Visible = showAbility
				if showAbility then
					abilityLabel.Text = "Ability: " .. tostring(plr:GetAttribute("EquippedAbility") or "None")
				end
			end
			if statusLabel then
				statusLabel.Text = alive and "ALIVE" or "DEAD"
				statusLabel.TextColor3 = alive and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 70, 70)
			end
		end
	end
end

local function refreshAllPlayerESP()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			if playerEspEnabled then createESP(plr) else removeESP(plr) end
		end
	end
end

local function setupPlayerESP(plr)
	if plr == player then return end
	plr.CharacterAdded:Connect(function()
		if playerEspEnabled then
			task.wait(0.8)
			createESP(plr)
		end
	end)
	if plr.Character and playerEspEnabled then
		task.defer(function()
			task.wait(0.5)
			createESP(plr)
		end)
	end
end

local cachedBall, lastBallSearch = nil, 0

local function getBall()
	local folder = workspace:FindFirstChild("Balls")
	if not folder then
		cachedBall = nil
		return nil
	end

	if cachedBall and cachedBall.Parent == folder then
		if cachedBall:GetAttribute("realBall") then
			return cachedBall
		end
	end

	local now = tick()
	if now - lastBallSearch < 0.08 then
		return cachedBall
	end
	lastBallSearch = now

	for _, v in ipairs(folder:GetChildren()) do
		if v:GetAttribute("realBall") then
			cachedBall = v
			return v
		end
	end

	for _, v in ipairs(folder:GetChildren()) do
		if v:IsA("BasePart") then
			cachedBall = v
			return v
		elseif v:IsA("Model") then
			local part = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
			if part then
				cachedBall = part
				return part
			end
		end
	end

	cachedBall = nil
	return nil
end

