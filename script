local function clearBallESP()
	if ballBeam then ballBeam:Destroy() ballBeam = nil end
	if ballAtt0 then ballAtt0:Destroy() ballAtt0 = nil end
	if ballAtt1 then ballAtt1:Destroy() ballAtt1 = nil end
	if ballVelocityBillboard then ballVelocityBillboard:Destroy() ballVelocityBillboard = nil end
end

local function updateBallESP()
	if not ballEspEnabled then
		clearBallESP()
		return
	end

	local ball = getBall()
	local localHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not ball or not localHRP then
		clearBallESP()
		return
	end

	local isTargetingMe = ball:GetAttribute("target") == player.Name

	if ballTracerEnabled then
		if not ballBeam then
			ballAtt0 = Instance.new("Attachment")
			ballAtt0.Parent = localHRP
			ballAtt1 = Instance.new("Attachment")
			ballAtt1.Parent = ball
			ballBeam = Instance.new("Beam")
			ballBeam.Attachment0 = ballAtt0
			ballBeam.Attachment1 = ballAtt1
			ballBeam.FaceCamera = true
			ballBeam.Width0 = 0.55
			ballBeam.Width1 = 0.55
			ballBeam.Transparency = NumberSequence.new(0.05)
			ballBeam.LightEmission = 1
			ballBeam.LightInfluence = 0
			ballBeam.Parent = localHRP
		end
		if ballAtt1.Parent ~= ball then ballAtt1.Parent = ball end
		if isTargetingMe then
			ballBeam.Color = ColorSequence.new(Color3.fromRGB(255, 40, 40))
		else
			ballBeam.Color = ColorSequence.new(Color3.fromRGB(255, 140, 0))
		end
		ballBeam.Enabled = true
	elseif ballBeam then
		ballBeam.Enabled = false
	end

	if ballVelocityEnabled then
		if not ballVelocityBillboard then
			ballVelocityBillboard = Instance.new("BillboardGui")
			ballVelocityBillboard.Size = UDim2.new(0, 120, 0, 28)
			ballVelocityBillboard.StudsOffset = Vector3.new(0, 3.2, 0)
			ballVelocityBillboard.AlwaysOnTop = true
			ballVelocityBillboard.Parent = ball
			local velLabel = Instance.new("TextLabel")
			velLabel.Name = "VelocityLabel"
			velLabel.Size = UDim2.new(1, 0, 1, 0)
			velLabel.BackgroundTransparency = 1
			velLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
			velLabel.TextStrokeTransparency = 0.3
			velLabel.TextSize = 14
			velLabel.Font = Enum.Font.GothamBold
			velLabel.Parent = ballVelocityBillboard
		end
		if ballVelocityBillboard.Parent ~= ball then ballVelocityBillboard.Parent = ball end
		local speed = 0
		if ball:IsA("BasePart") then
			local zoomies = ball:FindFirstChild("zoomies")
			speed = zoomies and zoomies.VectorVelocity.Magnitude or ball.AssemblyLinearVelocity.Magnitude
		end
		local velLabel = ballVelocityBillboard:FindFirstChild("VelocityLabel")
		if velLabel then velLabel.Text = string.format("%.0f studs/s", speed) end
		ballVelocityBillboard.Enabled = true
	elseif ballVelocityBillboard then
		ballVelocityBillboard.Enabled = false
	end
end

local function checkAutoParry()
	if not autoParryEnabled then return end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local ball = getBall()
	if not ball or not ball:IsA("BasePart") then return end
	local target = ball:GetAttribute("target")
	if target ~= player.Name then return end

	local ballPos = ball.Position
	local playerPos = hrp.Position
	local distance = (ballPos - playerPos).Magnitude
	local ballVel = ball.AssemblyLinearVelocity
	local zoomies = ball:FindFirstChild("zoomies")
	if zoomies then
		ballVel = zoomies.VectorVelocity
	end
	local playerVel = hrp.AssemblyLinearVelocity
	local ballSpeed = ballVel.Magnitude
	if ballSpeed < 5 then return end

	local now = tick()
	if distance < failSafeDistance then
		local failSafeCooldown = closeRangeSpam and 0.045 or 0.065
		if now - lastHitTime > failSafeCooldown then
			lastHitTime = now
			task.delay(math.random(15, 35) / 1000, doClick)
			return
		end
	end

	local relativeVel = ballVel - playerVel
	local toPlayer = (playerPos - ballPos)
	if toPlayer.Magnitude < 0.05 then return end
	local closingSpeed = relativeVel:Dot(toPlayer.Unit)
	if closingSpeed < 2 then return end

	local timeToHit = distance / math.max(closingSpeed, 1)
	local maxTime = math.clamp((0.155 + ballSpeed / 145) * parrySensitivity, 0.13, 0.70)
	local maxDistance = math.clamp((13 + ballSpeed * 0.14) * parrySensitivity, 12, 65)
	local isVeryClose = distance < 12
	local isMid = distance >= 12 and distance < 32

	if (timeToHit <= maxTime and distance <= maxDistance) or isVeryClose then
		local cooldown
		if closeRangeSpam and isVeryClose then
			cooldown = 0.048
		elseif isVeryClose then
			cooldown = 0.060
		elseif isMid then
			cooldown = 0.075
		else
			cooldown = math.clamp(0.090 - (ballSpeed / 2800), 0.055, 0.090)
		end
		if now - lastHitTime > cooldown then
			lastHitTime = now
			task.delay(math.random(18, 40) / 1000, doClick)
		end
	end
end

